# Copy to .env and fill in local values. Never commit the real .env file.

# Postgres connection string. Matches docker-compose.yml at the repo root when
# running Postgres locally via `docker compose up -d`.
DATABASE_URL="postgresql://oeminventory:oeminventory_dev_only@localhost:5432/oeminventory?schema=public"

# Generate your own secrets locally, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-dev-only-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-dev-only-secret"

# Token lifetimes (jsonwebtoken duration strings, e.g. "15m", "7d")
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Origin allowed by CORS for browser requests (the Vite dev server / deployed frontend)
FRONTEND_ORIGIN="http://localhost:3000"

# NODE_ENV must be "development" or "test" to run the demo seed (`npx prisma db seed`);
# the seed refuses to run in any other environment (it creates accounts with a known dev-only password).
NODE_ENV="development"
PORT="4000"

# Reverse proxy trust. Unset/false (default) = X-Forwarded-For is IGNORED (safe; correct for local dev).
# Behind a proxy/load balancer set a hop count (e.g. 1) or trusted proxy addresses/CIDRs/names
# (e.g. loopback, 10.0.0.0/8). "true" is rejected at startup because it trusts any client-sent header.
# TRUST_PROXY="1"

# Failed-login rate limit (optional; defaults shown). DEVELOPMENT / SINGLE-INSTANCE ONLY: counters are in
# process memory (reset on restart, not shared between instances). Production needs a shared store such as Redis.
# LOGIN_MAX_FAILURES_PER_EMAIL="5"        # per (ip, email) pair
# LOGIN_MAX_FAILURES_PER_IP="50"          # per ip, any email
# LOGIN_FAILURE_WINDOW_SECONDS="900"
